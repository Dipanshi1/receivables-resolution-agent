# Environment mode: development, staging, production, test
APP_ENV=development

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/receivables_db

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# AI / LLM Configuration
AI_PROVIDER=gemini
LLM_API_KEY=placeholder_llm_api_key
LLM_MODEL=gemini-1.5-pro
